{
  "name": "polgubau-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm github:repos && pnpm github:contributions && pnpm npm:downloads",
    "build": "astro check && astro build",
    "postbuild": "node scripts/validate-seo.js",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "github:repos": "node src/lib/github-stats/github-repos-report.mjs --user polgubau --fallback 55 --output src/lib/github-stats/github-repos.json",
    "github:contributions": "node src/lib/github-stats/github-contributions-report.mjs --user polgubau --output src/lib/github-stats/github-contributions.json",
    "npm:downloads": "node src/lib/npm-stats/npm-downloads-report.mjs --user pol-gubau --scope mesalvo --scope doscientos --scope codedbypol --scope polgubau --scope wisemark --output src/lib/npm-stats/npm-downloads.json",
    "validate:seo": "node scripts/validate-seo.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:images:dry": "node scripts/optimize-images.js --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.3",
    "@astrojs/react": "^4.4.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@fontsource/inter": "^5.2.8",
    "@iconify-json/lucide": "^1.2.107",
    "@iconify-json/simple-icons": "^1.2.82",
    "@polgubau/animated": "^1.0.13",
    "@polgubau/astro-reveal": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^5.6.1",
    "astro-icon": "^1.1.5",
    "medium-zoom": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.26.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro-meta-tags": "^0.3.1",
    "sharp": "^0.34.1",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
