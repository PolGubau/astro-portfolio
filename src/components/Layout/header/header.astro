---
import { getLocale, useTranslations } from "../../../i18n/utils";
import { metadata } from "../../../lib/constants";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const [heroTitleLead, ...heroTitleRestParts] = t("home.hero.title").split(", ");
const heroTitleRest = heroTitleRestParts.join(", ");
const npmDownloads = Number(metadata.npmDownloads);
const formattedNpmDownloads = new Intl.NumberFormat(locale).format(
  npmDownloads,
);
const githubRepositories = Number(metadata.githubRepositories);
const formattedGitHubRepositories = new Intl.NumberFormat(locale).format(
  githubRepositories,
);

const stats = [
  {
    value: formattedNpmDownloads,
    label: t("home.stats.npm"),
    npmDownloads,
  },
  { value: "1M+", label: t("home.stats.vercel") },
  { value: formattedGitHubRepositories, label: t("home.stats.projects") },
];
---

<header class="flex flex-col gap-8 py-12 md:py-16">
  <div class="flex flex-col items-start gap-4 max-w-3xl">
    <h1
      data-reveal="bottom"
      data-speed="fast"
      data-easing="soft"
      class="text-4xl md:text-5xl text-balance font-medium leading-[0.98]"
    >
      <span class="md:block">{heroTitleLead},</span>{" "}
      <span class="md:block">{heroTitleRest}</span>
    </h1>
    <p
      data-reveal="bottom"
      data-delay="120"
      data-easing="soft"
      class="text-base md:text-lg text-ink/60 max-w-xl text-balance"
      set:html={t("home.hero.intro")}
    />
  </div>

  <div
    data-reveal="bottom"
    data-delay="200"
    data-easing="soft"
    class="flex flex-wrap items-center gap-2"
  >
    {
      stats.map(({ value, label, npmDownloads }) => (
        <div class="inline-flex items-center gap-2 rounded-lg bg-ink/5 px-3 py-2">
          {typeof npmDownloads === "number" ? (
            <span
              data-npm-downloads
              data-value={npmDownloads}
              data-locale={locale}
              class="text-base md:text-lg font-medium tabular-nums"
            >
              {value}
            </span>
          ) : (
            <span class="text-base md:text-lg font-medium">{value}</span>
          )}
          <span class="text-xs text-ink/55">{label}</span>
        </div>
      ))
    }
  </div>
</header>
