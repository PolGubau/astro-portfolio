---
import { Icon } from "astro-icon/components";
import { getLocale, useTranslations } from "../../i18n/utils";
import { metadata } from "../../lib/constants";
import type { ProjectMetadata } from "../../lib/utils";
import ProjectListRow from "../Projects/ProjectListRow.astro";
import NpmIcon from "../icons/NpmIcon.astro";
import VercelIcon from "../icons/VercelIcon.astro";

interface Props {
  projects: ProjectMetadata[];
}

const { projects } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const npmDownloads = Number(metadata.npmDownloads);
const formattedNpmDownloads = new Intl.NumberFormat(locale).format(
  npmDownloads,
);
---

<section class="flex flex-col gap-12">
  <div class="flex items-baseline justify-between gap-4">
    <h2
      data-reveal="bottom"
      data-speed="fast"
      class="text-2xl md:text-3xl font-medium"
    >
      {t("home.side.title")}
    </h2>
    <div class="flex items-center gap-6">
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={metadata.links.npm}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal="bottom"
          data-speed="fast"
          title={`${formattedNpmDownloads} ${t("stats.npmTooltip")}`}
          aria-label={`${formattedNpmDownloads} ${t("stats.npmTooltip")}`}
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-50 border border-red-200 text-red-600 text-xs font-medium shadow-sm hover:-translate-y-px hover:bg-red-100 hover:shadow-red-200/60 transition-[background-color,box-shadow,transform] shrink-0 dark:bg-red-950/40 dark:border-red-900/60 dark:text-red-300 dark:hover:bg-red-950/60"
        >
          <NpmIcon class="w-3 h-3" aria-hidden="true" />
          <span
            data-npm-downloads
            data-value={npmDownloads}
            data-locale={locale}
            aria-hidden="true"
            class="min-w-[7ch] text-right tabular-nums tracking-tight"
          >
            {formattedNpmDownloads}
          </span>
          <span
            class="h-1 w-1 rounded-full bg-red-400 dark:bg-red-500"
            aria-hidden="true"></span>
          <span class="hidden sm:inline text-red-400 dark:text-red-500/70"
            >{t("home.side.downloads")}</span
          >
        </a>
        <span
          data-reveal="bottom"
          data-speed="fast"
          data-delay="80"
          title={`${metadata.vercelViews} ${t("stats.vercelTooltip")}`}
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-100 text-xs font-medium shrink-0"
        >
          <VercelIcon class="w-3 h-3" aria-hidden="true" />
          <span class="hidden sm:inline"
            >{metadata.vercelViews} {t("home.side.views")}</span
          >
          <span class="sm:hidden">{metadata.vercelViews}</span>
        </span>
        <a
          href={metadata.links.github}
          target="_blank"
          data-reveal="bottom"
          data-speed="fast"
          data-delay="160"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-sm text-ink/50 hover:text-ink transition-colors shrink-0"
        >
          {t("home.viewAll")}
          <Icon
            name="lucide:arrow-right"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
  <ProjectListRow projects={projects} />
</section>

<script>
  const formatterByLocale = new Map<string, Intl.NumberFormat>();

  function formatDownloads(value: number, locale: string) {
    if (!formatterByLocale.has(locale)) {
      formatterByLocale.set(locale, new Intl.NumberFormat(locale));
    }
    return formatterByLocale.get(locale)!.format(value);
  }

  function isDigit(character: string) {
    return character >= "0" && character <= "9";
  }

  function renderNumberFlow(
    element: HTMLElement,
    value: number,
    locale: string,
  ) {
    const formatted = formatDownloads(value, locale);
    const reels: HTMLElement[] = [];
    const fragment = document.createDocumentFragment();

    for (const character of formatted) {
      if (!isDigit(character)) {
        const separator = document.createElement("span");
        separator.className = "number-flow-separator";
        separator.textContent = character;
        separator.setAttribute("aria-hidden", "true");
        fragment.append(separator);
        continue;
      }

      const digit = Number(character);
      const slot = document.createElement("span");
      const reel = document.createElement("span");
      slot.className = "number-flow-digit";
      reel.className = "number-flow-reel";
      reel.dataset.digit = character;
      reel.style.transform = `translateY(-${digit * 1.1}em)`;

      for (let index = 0; index <= 11; index += 1) {
        const glyph = document.createElement("span");
        glyph.className = "number-flow-glyph";
        glyph.textContent = String(index % 10);
        glyph.setAttribute("aria-hidden", "true");
        reel.append(glyph);
      }

      slot.append(reel);
      fragment.append(slot);
      reels.push(reel);
    }

    element.classList.add("number-flow");
    element.replaceChildren(fragment);
    element.setAttribute("aria-label", formatted);
    return reels;
  }

  function updateNumberFlow(
    element: HTMLElement,
    reels: HTMLElement[],
    value: number,
    locale: string,
  ) {
    const formatted = formatDownloads(value, locale);
    const digits = [...formatted].filter(isDigit);
    if (digits.length !== reels.length)
      return renderNumberFlow(element, value, locale);

    reels.forEach((reel, index) => {
      const next = Number(digits[index]);
      const previous = Number(reel.dataset.digit);
      if (next === previous) return;

      reel.dataset.digit = String(next);
      if (next < previous) {
        reel.style.transform = `translateY(-${(next + 10) * 1.1}em)`;
        reel.addEventListener(
          "transitionend",
          () => {
            reel.style.transition = "none";
            reel.style.transform = `translateY(-${next * 1.1}em)`;
            requestAnimationFrame(() =>
              reel.style.removeProperty("transition"),
            );
          },
          { once: true },
        );
      } else {
        reel.style.transform = `translateY(-${next * 1.1}em)`;
      }
    });

    element.setAttribute("aria-label", formatted);
    return reels;
  }

  function animateDownloads(element: HTMLElement) {
    if (element.dataset.animated) return;
    const total = Number(element.dataset.value);
    if (!Number.isSafeInteger(total)) return;

    const locale = element.dataset.locale ?? document.documentElement.lang;
    const startDistance = Math.max(10, Math.round(total * 0.0002));
    const storageKey = `npm-live-counter:${total}`;
    const fallback = Math.max(
      0,
      total - Math.round(startDistance * (0.75 + Math.random() * 0.5)),
    );
    let value = fallback;

    try {
      const storedValue = window.sessionStorage.getItem(storageKey);
      const stored = storedValue === null ? Number.NaN : Number(storedValue);
      if (Number.isSafeInteger(stored) && stored >= total - startDistance * 2) {
        value = stored;
      }
      window.sessionStorage.setItem(storageKey, String(value));
    } catch {
      // Storage can be unavailable in private or restricted browsing contexts.
    }

    element.dataset.animated = "true";
    let reels = renderNumberFlow(element, value, locale);
    function scheduleNextTick() {
      const delay =
        Math.random() < 0.08
          ? 2_800 + Math.random() * 2_600
          : 700 + Math.random() * 1_100;

      window.setTimeout(() => {
        if (!element.isConnected) {
          return;
        }

        value += Math.random() < 0.1 ? 2 : 1;
        reels = updateNumberFlow(element, reels, value, locale);
        try {
          window.sessionStorage.setItem(storageKey, String(value));
        } catch {
          // Keep the visual counter working even when storage is unavailable.
        }
        scheduleNextTick();
      }, delay);
    }
    scheduleNextTick();
  }

  const counters = document.querySelectorAll<HTMLElement>(
    "[data-npm-downloads]",
  );
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          animateDownloads(entry.target as HTMLElement);
          currentObserver.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    counters.forEach((counter) => observer.observe(counter));
  } else if (!reduceMotion) {
    counters.forEach(animateDownloads);
  }
</script>
