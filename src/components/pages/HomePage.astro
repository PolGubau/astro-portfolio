---
import { getLocale, useTranslations } from "../../i18n/utils";
import MainLayout from "../../layouts/MainLayout.astro";
import { getLocalizedProject } from "../../lib/utils";
import "../../styles/cards.css";
import GitHubGrid from "../GitHub/GitHubGrid.astro";
import Header from "../Layout/header/header.astro";
import BeyondCodeSection from "../home/BeyondCodeSection.astro";
import PerformanceCards from "../home/PerformanceCards.astro";
import WorkSection from "../home/WorkSection.astro";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const featuredProjects = [
  "les-santes",
  "polui",
  "doscientos",
  "novahair",
  "arenas",
].map((slug) => {
  const project = getLocalizedProject(slug, locale);
  if (!project) throw new Error(`Featured project not found: ${slug}`);
  return project;
});
---

<MainLayout title={t("seo.home.title")} description={t("seo.home.description")}>
  <div>
    <Header />
    <main class="flex w-full flex-1 flex-col gap-20 md:gap-32">
      <WorkSection projects={featuredProjects} />
      <GitHubGrid />
      <BeyondCodeSection />
      <PerformanceCards />
    </main>
  </div>
</MainLayout>
