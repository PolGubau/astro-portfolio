---
import arrow from "../../assets/media/branding/arrow.svg?raw";
import cursor from "../../assets/media/branding/cursor.svg?raw";
import message from "../../assets/media/branding/message.svg?raw";
import star from "../../assets/media/branding/star.svg?raw";

const icons = [star, arrow, cursor, message];
---

<div
  class="flex items-center gap-2 w-fit rounded-full text-ink px-2 py-2 font-medium backdrop-blur-md"
>
  {
    icons.map((icon) => (
      <span
        aria-hidden="true"
        class="h-5 w-5 [&>svg]:h-full [&>svg]:w-full"
        set:html={icon}
      />
    ))
  }
</div>
