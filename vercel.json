{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:es/|ca/)?404/?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/(?!(?:es/|ca/)?404/?$).*$",
      "headers": {
        "X-Robots-Tag": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      },
      "continue": true
    },
    {
      "src": "/sitemap.xml",
      "status": 308,
      "headers": {
        "Location": "/sitemap-index.xml"
      }
    },
    {
      "src": "/_astro/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/es(/.*)?$",
      "dest": "/es/404",
      "status": 404
    },
    {
      "src": "^/ca(/.*)?$",
      "dest": "/ca/404",
      "status": 404
    }
  ]
}
